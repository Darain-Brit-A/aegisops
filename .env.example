# ==============================================================================
# AegisOps Environment Configuration Template
# Copy to .env for local development. NEVER commit .env or real credentials.
# All tokens below are synthetic local development placeholders ONLY.
# ==============================================================================

# --- Platform Identity & Region ---
AEGISOPS_ENV=development
AEGISOPS_REGION_ID=ap-south-1
AEGISOPS_ALLOWED_REGIONS=ap-south-1,eu-central-1,us-east-1
AEGISOPS_POLICY_VERSION=1

# --- Tier 2: PostgreSQL (SaaS Backend) ---
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=local_dev_postgres_password_change_me
POSTGRES_DB=aegisops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aegisops:local_dev_postgres_password_change_me@localhost:5432/aegisops

# --- Tier 2: SaaS Backend Service ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HEARTBEAT_STALE_SECONDS=45
BACKEND_HEARTBEAT_OFFLINE_SECONDS=60

# Synthetic development bootstrap credentials (collector -> SaaS & dashboard -> SaaS)
# Format in backend seed: tenant_id, collector_id, token_hash (derived at startup in dev)
AEGISOPS_DEV_TENANT_A_ID=tenant-acme-prod
AEGISOPS_DEV_TENANT_A_COLLECTOR_ID=col-acme-blr-01
AEGISOPS_DEV_TENANT_A_COLLECTOR_TOKEN=dev-col-token-acme-local-placeholder
AEGISOPS_DEV_TENANT_A_OPERATOR_TOKEN=dev-op-token-acme-local-placeholder

AEGISOPS_DEV_TENANT_B_ID=tenant-globex-prod
AEGISOPS_DEV_TENANT_B_COLLECTOR_ID=col-globex-fra-01
AEGISOPS_DEV_TENANT_B_COLLECTOR_TOKEN=dev-col-token-globex-local-placeholder
AEGISOPS_DEV_TENANT_B_OPERATOR_TOKEN=dev-op-token-globex-local-placeholder

# --- Tier 1: Local Collector Service ---
# NOTE: Local dev uses loopback HTTP; production/deployed demos MUST use https:// with TLS verification.
COLLECTOR_ID=col-acme-blr-01
COLLECTOR_ENVIRONMENT_ID=env-blr-dc1
COLLECTOR_REGION_ID=ap-south-1
COLLECTOR_VERSION=0.1.0
COLLECTOR_SOURCE_TIMEZONE=Asia/Kolkata
COLLECTOR_SAAS_INGEST_URL=http://localhost:8000/api/v1/ingest/telemetry
COLLECTOR_SAAS_HEARTBEAT_URL=http://localhost:8000/api/v1/ingest/heartbeat
COLLECTOR_AUTH_TOKEN=dev-col-token-acme-local-placeholder
COLLECTOR_TLS_VERIFY=true
COLLECTOR_HMAC_SECRET=local-only-pseudonym-salt-change-me-never-transmit
COLLECTOR_SQLITE_PATH=./collector/data/collector_local.db
COLLECTOR_RAW_RETENTION_HOURS=24
COLLECTOR_INSPECT_HOST=127.0.0.1
COLLECTOR_INSPECT_PORT=8001
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=10
COLLECTOR_FLUSH_INTERVAL_SECONDS=2

# Telemetry source adapter: simulator | psutil | organizer_stream
COLLECTOR_ADAPTER_MODE=simulator
COLLECTOR_ORGANIZER_STREAM_URL=

# --- Frontend Dashboard ---
VITE_SAAS_API_BASE_URL=http://localhost:8000/api/v1
VITE_LOCAL_COLLECTOR_INSPECT_URL=http://127.0.0.1:8001
VITE_POLL_INTERVAL_MS=3000
VITE_APP_NAME=AegisOps
